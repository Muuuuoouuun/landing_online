{
  "name": "classin-motion",
  "version": "0.1.0",
  "private": true,
  "description": "ClassIn 20s kinetic-typography commercial (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ClassIn20 out/classin-20s.mp4",
    "render:animatic": "remotion render Animatic out/animatic.mp4",
    "still": "remotion still",
    "sfx": "python3 scripts/make-sfx.py",
    "bgm": "python3 scripts/make-bgm.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/east-sea-dokdo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/animation-utils": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/effects": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/layout-utils": "4.0.533",
    "@remotion/light-leaks": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/paths": "4.0.533",
    "@remotion/shapes": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "lucide": "1.52.0",
    "pretendard": "1.3.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
